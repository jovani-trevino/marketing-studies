# Sólo para `npm run dev`; PHP en producción no lee automáticamente este archivo.
# No incluir contraseñas reales en Git. Copia este archivo a .env para desarrollo.
MS_DB_DRIVER=sqlite
MS_APP_URL=http://127.0.0.1:4173
# Sin rutas explícitas, el servidor de desarrollo aísla sus datos en .preview/.
# MS_SQLITE_PATH=/ruta/privada/de/desarrollo/blog.sqlite
# MS_STORAGE_PATH=/ruta/privada/de/desarrollo
# MS_SESSION_PATH=/ruta/privada/de/desarrollo/sessions
# MS_RATE_LIMIT_PATH=/ruta/privada/de/desarrollo/rate-limits
# MS_CONFIG_FILE=/ruta/privada/de/desarrollo/config.php
# MS_PHP_BINARY=/ruta/al/ejecutable/php
# Fuerza el runtime de desarrollo PHP WASM si PHP nativo no está disponible.
# MS_DEV_WASM=1
